{
  "id": "./app.html",
  "name": "JAIMIE",
  "short_name": "JAIMIE",
  "description": "A private, local-first personal operating system for planning, health, finance and intelligence.",
  "start_url": "./app.html#/dashboard/index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#101113",
  "theme_color": "#111214",
  "categories": ["productivity", "lifestyle", "utilities"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "./assets/jaimie-icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./assets/jaimie-icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./assets/jaimie-icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "./assets/jaimie-icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ]
}
